# Copy this file to .env and fill in your key.
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# Threshold (0-1) above which the LLM-based crisis classifier counts as a match.
# Lower = more sensitive (more false positives, fewer false negatives).
CRISIS_LLM_THRESHOLD=0.5
